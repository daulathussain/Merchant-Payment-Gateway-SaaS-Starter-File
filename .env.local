
## GET HERE: https://supabase.com/
NEXT_PUBLIC_SUPABASE_URL=supabase_url
NEXT_PUBLIC_SUPABASE_ANON_KEY=supabase_anon_key
SUPABASE_SERVICE_ROLE_KEY=supabase_service_role_key


## ANKR GET HERE: https://www.ankr.com/rpc/
POLYGON_RPC_URL=https://rpc.ankr.com/polygon/api_key

# The public endpoints below (used as fallbacks when these are unset) are rate-limited and
# unsuitable for production traffic. Create an app with a real RPC provider (Alchemy, Infura,
# QuickNode, Ankr, etc.) PER NETWORK and put its URL in the matching variable before accepting real
# payments. RPC keys are chain-specific — a key issued for one chain will not work on another.
ETHEREUM_RPC_URL=https://rpc.ankr.com/eth/api_key
BNB_RPC_URL=https://rpc.ankr.com/bsc/api_key

# Optional ERC-20 contract overrides — real Circle/Tether contracts are already built in for all
# three networks (see lib/chains.ts).
POLYGON_USDC_CONTRACT=0x3c499c542cEF5E3811e1192ce70d8cC03d5c3359
POLYGON_USDT_CONTRACT=0xc2132D05D31c914a87C6611C10748AEb04B58e8F
ETHEREUM_USDC_CONTRACT=0xA0b86991c6218b36c1d19D4a2e9Eb0cE3606eB48
ETHEREUM_USDT_CONTRACT=0xdAC17F958D2ee523a2206206994597C13D831ec7
BNB_USDC_CONTRACT=0x8AC76a51cc950d9822D68b83fE1Ad97B32Cd580d
BNB_USDT_CONTRACT=0x524bC91Dc82d6b90EF29F76A3ECAaBAffFD490Bc

# Required to enable background payment reconciliation (app/api/cron/reconcile/route.ts) — settles
# orders whose customer paid on-chain but closed their browser before the client-side poll caught
# it. Generate any long random string; the route only accepts requests sending this exact value as
# `Authorization: Bearer <value>`. Trigger the route periodically (every 5-15 min) with whatever
# scheduler your deployment uses — this repo does not wire one up automatically.
CRON_SECRET=fe20f4d9b4be286edd8e305c11e13ba68ee80369c5b62fd1e062e9170a8d5e47

## GET HERE: https://coinstats.app/api-docs/
# Powers live USD-priced payment links (see lib/coinstats.ts) — a merchant can price a link in USD
# instead of a fixed token amount, and the native-token amount is computed from a live rate at
# order-mint time. Leave unset and USD-mode pricing simply fails with a clean "temporarily
# unavailable" error; fixed-amount pricing is unaffected either way.
COINSTATS_API_KEY=api-key

# Pro/Business subscription payments (see lib/plans.ts, lib/subscriptions.ts) — merchants pay
# these plans in native tokens (POL/ETH/BNB), converted from the USD prices below at checkout time,
# straight to this wallet. This is the platform's OWN receiving wallet, never a merchant's.
SUBSCRIPTION_WALLET_ADDRESS=wallet_address
# USD price per 30-day period. Change anytime — takes effect on the next checkout with no
# code change or redeploy-of-logic needed. Falls back to 29/99 if unset or invalid.
PRO_PLAN_PRICE_USD=29
BUSINESS_PLAN_PRICE_USD=99
